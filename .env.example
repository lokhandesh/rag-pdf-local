# Copy to .env and adjust.

# --- LLM: ollama (local, free) | anthropic (Claude API) | none (retrieval only) ---
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Embeddings: fastembed (semantic) | hash (offline, tests only) ---
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Chunking & retrieval ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
MIN_SCORE=0.0

# --- Paths ---
DATA_DIR=data/pdfs
CHROMA_DIR=storage/chroma
